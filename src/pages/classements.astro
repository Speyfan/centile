---
/**
 * `/classements` sans saison : la plus récente. C'est l'entrée du menu, elle
 * doit mener à quelque chose plutôt qu'à un choix.
 */
import Base from "../layouts/Base.astro";
import RankingTable from "../components/RankingTable.astro";
import { getLeagueIndex, getMeta, getRanking, listRankingYears } from "../lib/data";
import { isSeasonInProgress } from "../lib/display";

const meta = getMeta();
const years = listRankingYears();
const year = years[years.length - 1]!;
const ranking = getRanking(year);
const leagues = getLeagueIndex();
---

<Base
  title="Classements | LoL Scout"
  description="Classement des joueurs professionnels de League of Legends, score mondial sur 100 par rôle et par ligue."
>
  <h1 class="m-0 text-2xl font-bold tracking-tight">Classement {year}</h1>

  <nav class="mt-3 flex flex-wrap gap-1.5" aria-label="Saison">
    {years.map((other) => (
      <a
        href={`/classements/${other}`}
        aria-current={other === year}
        class="tnum rounded-md border border-line bg-surface px-2.5 py-1 text-xs text-muted aria-[current=true]:border-accent/50 aria-[current=true]:bg-accent/10 aria-[current=true]:text-ink"
      >
        {other}
      </a>
    ))}
  </nav>

    {
      isSeasonInProgress(year, meta) && (
        <p class="mt-2 rounded-md border border-line bg-surface px-3 py-2 text-xs leading-snug text-muted">
          <strong class="font-medium text-ink">Saison en cours.</strong> Les
          volumes sont encore courts et les intervalles larges : un joueur peut
          tenir le haut du tableau sur vingt parties. Le classement se
          stabilise à mesure que la saison avance.
        </p>
      )
    }

  <div class="mt-4">
    <RankingTable ranking={ranking} meta={meta} leagues={leagues} />
  </div>
</Base>
