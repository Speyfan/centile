---
/**
 * Coquille de toutes les pages.
 *
 * Le pied de page porte la traçabilité — date d'export, calibration de
 * l'échelle, version du modèle. Ce n'est pas une mention légale : un score
 * screenshoté doit pouvoir être rattaché au modèle qui l'a produit.
 */
import { getMeta } from "../lib/data";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const meta = getMeta();
const exported = new Date(meta.generated_at).toLocaleDateString("fr-FR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta name="theme-color" content="#0b0e14" />
  </head>
  <body class="bg-bg text-ink">
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
        <a href="/" class="text-sm font-semibold tracking-tight">LoL&nbsp;Scout</a>
        <nav class="flex gap-4 text-sm text-muted">
          <a href="/classements" class="hover:text-ink">Classements</a>
          <a href="/methode" class="hover:text-ink">Méthode</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 pb-16 pt-5">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-3xl px-4 py-5 text-xs leading-relaxed text-faint">
        <p>
          Données Oracle's Elixir, saisons {meta.corpus.first_year}–{
            meta.corpus.last_year
          }. Export du {exported} · modèle <span class="font-mono">{meta.model_version}</span> ·
          échelle calibrée le {meta.score_scale.calibrated_on}.
        </p>
        <p class="mt-1">
          Un score n'est comparable d'une ligue à l'autre que s'il est publié.
          <a href="/methode" class="underline decoration-line underline-offset-2">
            Comment il est calculé
          </a>.
        </p>
      </div>
    </footer>
  </body>
</html>
