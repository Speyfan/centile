---
/**
 * Le score en gros — avec son ±, son intervalle et son statut.
 *
 * Règle non négociable : jamais un score sans son ±. Le composant n'accepte
 * donc pas de valeur nue, seulement un objet `score` qui porte ses bornes.
 * Un score `experimental` porte un badge explicite : sa note situe le joueur
 * dans sa ligue, pas face aux autres ligues.
 */
import type { RatedScore } from "../lib/contract";
import { STATUS_LABELS, STATUS_NOTES, intervalText, num, plusMinus } from "../lib/display";

interface Props {
  score: RatedScore;
}

const { score } = Astro.props;
const pm = plusMinus(score);

const badge: Record<string, string> = {
  published: "border-tone-high/40 bg-tone-high/10 text-tone-high",
  experimental: "border-tone-mid/40 bg-tone-mid/10 text-tone-mid",
  no_anchor: "border-tone-low/40 bg-tone-low/10 text-tone-low",
  unrated: "border-line bg-surface text-muted",
};
---

<div class="flex flex-col items-start gap-1 sm:items-end">
  <div class="flex items-baseline gap-1.5">
    <span
      class="tnum text-[3.25rem] font-bold leading-none tracking-tight"
      aria-label={`Score ${num(score.world)} sur 100, intervalle ${intervalText(score)}`}
    >
      {num(score.world)}
    </span>
    <span class="text-lg text-faint">/100</span>
    <span class="tnum ml-1 whitespace-nowrap text-base font-medium text-muted"
      >± {num(pm)}</span
    >
  </div>

  <p class="tnum text-xs text-faint">
    Intervalle 95 % : {intervalText(score)}
    {score.clipped && <span class="text-tone-mid"> · au plafond de l'échelle</span>}
  </p>

  <span
    class={`mt-1 inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium ${badge[score.status] ?? badge.unrated}`}
    title={STATUS_NOTES[score.status]}
  >
    {STATUS_LABELS[score.status] ?? score.status}
  </span>

  {
    score.status !== "published" && (
      <p class="max-w-xs text-xs leading-snug text-tone-mid sm:text-right">
        {STATUS_NOTES[score.status]}
      </p>
    )
  }
</div>
